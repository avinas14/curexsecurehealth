 const upcomingHtml=ap.filter(a=>a.status==='scheduled').sort((a,b)=>a.date.localeCompare(b.date)).slice(0,4).map(a=>`<div class="activity"><span class="activity-icon">▦</span><div class="activity-body"><b>${esc(a.type)}</b><p>${esc(byDoctor(a.doctorId).name)} · ${esc(byPatient(a.patientId).name)}</p></div><time>${fmtDate(a.date)}<br>${esc(a.time)}</time></div>`).join('')||empty('▦','No upcoming visits','Appointments will show here.');
 $('#page-content').innerHTML=heading(currentRole==='patient'?`Good morning, ${esc(p.name.split(' ')[0])} 👋`:currentRole==='doctor'?`Welcome, ${esc(doctor().name)}`:'Operations at a glance','Your health information, sharing permissions, and activity — all in one secure place.',actions)+
 `<div class="welcome-card"><div><div class="eyebrow">YOUR HEALTH, YOUR CHOICE</div><h2>${currentRole==='patient'?'Your health story, in one place.':currentRole==='doctor'?'Care with the complete picture.':'Privacy operations overview.'}</h2><p>${currentRole==='patient'?'Review your records, manage consent, and see exactly who has accessed your information.':currentRole==='doctor'?'Access only the records patients have explicitly shared with you.':'Monitor sharing activity and review access events across the fictional demo environment.'}<br><b>${DEMO}</b></p></div><div class="welcome-actions"><button class="btn btn-primary" data-view="sharing">Review sharing requests →</button><button class="btn btn-soft" data-view="audit">View access history</button></div></div>
 <div class="grid stats-grid">${stats}</div><div class="grid dashboard-grid"><div>${panel('Recent activity','A transparent timeline of important events',`<div class="activity-list">${recent}</div>`,`<button class="text-link" data-view="audit">View all →</button>`)}${panel('Medical records','Your latest health documents',`<div class="activity-list">${prs.slice(0,4).map(r=>`<div class="activity"><span class="activity-icon">▤</span><div class="activity-body"><b>${esc(r.title)}</b><p>${esc(r.category)} · ${fmtDate(r.date)}</p></div><button class="text-link" data-action="view-record" data-id="${r.id}">View</button></div>`).join('')}</div>`,`<button class="text-link" data-view="records">All records →</button>`)}</div><div>${panel('Quick actions','Common tasks, one tap away',`<div class="grid quick-grid"><button class="quick-action" data-action="new-record"><span>＋</span><b>Add a record</b><small>Upload a report or prescription</small></button><button class="quick-action" data-action="new-share"><span>⌁</span><b>Share securely</b><small>Choose records and duration</small></button><button class="quick-action" data-view="emergency"><span>♡</span><b>Emergency access</b><small>Restricted clinical workflow</small></button><button class="quick-action" data-view="summaries"><span>✧</span><b>Health summary</b><small>Review source-linked summaries</small></button></div>`)}${panel('Upcoming appointments','Your next scheduled visits',`<div class="activity-list">${upcomingHtml}</div>`,`<button class="text-link" data-view="appointments">All appointments →</button>`)}</div></div>`;
}
function renderRecords(){
 let rows=patientRecords().filter(r=>(recordFilter==='all'||r.category===recordFilter)&&`${r.title} ${r.category} ${r.notes}`.toLowerCase().includes(searchTerm.toLowerCase()));
 const categories=['all',...new Set(patientRecords().map(r=>r.category))];
 const toolbar=`<div class="toolbar"><label class="searchbox"><span>⌕</span><input id="record-search" placeholder="Search records, categories…" value="${esc(searchTerm)}"></label><select class="field" id="record-filter" style="width:auto;min-width:160px">${categories.map(c=>`<option value="${esc(c)}" ${c===recordFilter?'selected':''}>${c==='all'?'All categories':esc(c)}</option>`).join('')}</select><button class="btn btn-primary" data-action="new-record">＋ Add record</button></div>`;
 $('#page-content').innerHTML=heading('Medical records','A private, organized timeline of reports, prescriptions, and care history.',`<button class="btn btn-soft" data-action="export-records">↓ Export list</button>`)+`<div class="alert info"><span>♧</span><div><strong>Access is consent-based</strong>Only records explicitly selected by you should be shared. This demo stores record metadata locally; file storage needs Supabase configuration.</div></div>${toolbar}<div class="grid record-grid">${rows.map(r=>`<article class="record-card"><div class="record-icon">${r.category==='Prescription'?'✚':r.category==='Laboratory report'?'⚗':'▤'}</div><h3>${esc(r.title)}</h3><p>${esc(r.notes)}</p><div class="record-meta"><span>${esc(r.category)}</span><span>${fmtDate(r.date)}</span></div><div class="record-actions"><button class="btn btn-soft btn-sm" data-action="view-record" data-id="${r.id}">View details</button><button class="btn btn-sm" data-action="share-one" data-id="${r.id}">Share</button></div></article>`).join('')||empty('▤','No records found','Try a different search or add a new record.','<button class="btn btn-primary" data-action="new-record">Add record</button>')}</div>`;
}
function renderMedications(){
 const p=patient();
