/strong>${p.allergies.filter(a=>!/^none/i.test(a)).length?`Recorded allergy: ${p.allergies.filter(a=>!/^none/i.test(a)).map(esc).join(', ')}. Any proposed prescription must be reviewed against this information.`:'No allergy is recorded. Missing information does not mean no risk.'}</div></div><button class="btn btn-soft" data-action="safety-check">Run demo safety checklist</button><div id="safety-result" class="mt-16"></div>`)}`;
