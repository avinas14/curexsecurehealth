 $('#page-content').innerHTML=heading('Access history','A transparent timeline of record access, consent changes, and security events.',`<button class="btn btn-soft" data-action="export-audit">↓ Export audit log</button>`)+`<div class="alert info"><span>◷</span><div><strong>Audit trail</strong>Demo events are stored locally and can be edited by someone with access to this browser. Production audit logs must be written and protected server-side.</div></div><div class="toolbar"><label class="searchbox"><span>⌕</span><input id="audit-search" placeholder="Search activity, actor, outcome…" value="${esc(searchTerm)}"></label><select class="field" id="audit-outcome" style="width:auto"><option value="all">All outcomes</option><option>approved</option><option>denied</option><option>revoked</option><option>expired</option><option>rejected</option><option>reviewed</option></select></div>${panel('Event timeline',`${rows.length} visible events`,rows.length?`<div class="table-wrap"><table><thead><tr><th>Date & time</th><th>Actor / role</th><th>Action</th><th>Patient</th><th>Outcome</th><th>Details</th></tr></thead><tbody>${rows.map(a=>`<tr><td>${fmtTime(a.date)}</td><td><b>${esc(a.actor)}</b><br><small class="muted">${esc(a.role)} · ${esc(a.org)}</small></td><td>${esc(a.action)}</td><td>${esc(byPatient(a.patientId).name)}</td><td>${status(a.outcome)}</td><td>${esc(a.detail)}</td></tr>`).join('')}</tbody></table></div>`:empty('◷','No matching events','Try another search term.') )}`;
