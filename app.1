let db, supa=null, currentRole='patient', currentPatient='p1', currentView='overview', chart=null, searchTerm='', recordFilter='all';
function clone(x){return JSON.parse(JSON.stringify(x))}
function loadDB(){try{const raw=localStorage.getItem('curex-demo-db-v1');if(raw){const d=JSON.parse(raw);if(d.version===1)return d.data}}catch(e){}return clone(seed)}
function saveDB(){try{localStorage.setItem('curex-demo-db-v1',JSON.stringify({version:1,data:db}));}catch(e){toast('Local storage unavailable; changes may not persist.','error')}}
function persist(){saveDB();if(supa) syncToSupabase().catch(e=>console.warn('Supabase sync:',e))}
function addAudit(action,outcome='approved',detail='',patientId=currentPatient,recordId=null){db.audit.unshift({id:id(),actor:actorName(),role:currentRole,org:actorOrg(),patientId,recordId,action,outcome,detail,date:now()});if(db.audit.length>500)db.audit.length=500}
function actorName(){return currentRole==='patient'?patient().name:currentRole==='doctor'?doctor().name:'Administrator Demo'}
function actorOrg(){return currentRole==='patient'?'Patient portal':currentRole==='doctor'?doctor().organization:'Curex operations'}
function patient(){return db.patients.find(p=>p.id===currentPatient)||db.patients[0]}
function doctor(){return db.doctors[currentRole==='doctor'?1:0]||db.doctors[0]}
function byPatient(pid){return db.patients.find(p=>p.id===pid)||{name:'Unknown patient',id:pid}}
function byDoctor(did){return db.doctors.find(d=>d.id===did)||{name:'Unknown doctor',id:did,organization:'Unknown organization'}}
function rec(rid){return db.records.find(r=>r.id===rid)}
function status(s){return `<span class="status status-${esc(s)}">${esc(s)}</span>`}
function toast(msg,type='ok'){const el=document.createElement('div');el.className='toast '+(type==='error'?'error':'');el.textContent=msg;$('#toast-region').append(el);setTimeout(()=>el.remove(),3600)}
function titleFor(v){return ({overview:'Overview',records:'Medical records',medications:'Medications & allergies',appointments:'Appointments',sharing:'Consent & sharing',emergency:'Emergency access',summaries:'Health summaries',audit:'Access history',admin:'Administration',settings:'Settings'})[v]||v}
function heading(title,desc,actions=''){return `<div class="page-heading"><div><div class="eyebrow">${esc(currentRole==='patient'?'PATIENT PORTAL':currentRole==='doctor'?'CLINICIAN WORKSPACE':'SYSTEM OPERATIONS')}</div><h1>${title}</h1><p>${desc}</p></div><div class="heading-actions">${actions}</div></div>`}
function stat(label,value,note,icon){return `<article class="stat-card"><div class="stat-top"><span class="stat-label">${label}</span><span class="stat-icon">${icon}</span></div><div class="stat-number">${value}</div><div class="stat-note">${note}</div></article>`}
function panel(title,subtitle,body,action=''){return `<section class="panel"><div class="panel-header"><div><h2 class="panel-title">${title}</h2>${subtitle?`<p class="panel-subtitle">${subtitle}</p>`:''}</div>${action}</div>${body}</section>`}
function empty(icon,title,desc,action=''){return `<div class="empty-state"><div class="empty-icon">${icon}</div><b>${title}</b><p>${desc}</p>${action}</div>`}
function patientRecords(){return db.records.filter(r=>r.patientId===currentPatient)}
function renderOverview(){
 const p=patient(), prs=patientRecords(), sh=db.shares.filter(s=>s.patientId===currentPatient), ap=db.appointments.filter(a=>a.patientId===currentPatient), aud=db.audit.filter(a=>a.patientId===currentPatient).slice(0,5);
 const active=sh.filter(s=>s.status==='approved'&&new Date(s.expires)>new Date()).length;
 const upcoming=ap.filter(a=>a.status==='scheduled'&&a.date>=day()).length;
 const pending=sh.filter(s=>s.status==='pending').length;
 const stats=currentRole==='admin'?[stat('REGISTERED PATIENTS',db.patients.length,'Fictional demo profiles','♙'),stat('MEDICAL RECORDS',db.records.length,'Across demo dataset','▤'),stat('SHARING REQUESTS',db.shares.length,'All consent states','⌁'),stat('FLAGGED EVENTS',db.audit.filter(a=>a.outcome==='denied').length,'Review audit stream','⚑')]:currentRole==='doctor'?[stat('AUTHORIZED PATIENTS',db.patients.length,'Demo directory','♙'),stat('AVAILABLE RECORDS',db.records.length,'Consent still required','▤'),stat('PENDING REQUESTS',db.shares.filter(s=>s.status==='pending').length,'Awaiting patient action','⌁'),stat('UPCOMING VISITS',db.appointments.filter(a=>a.status==='scheduled'&&a.date>=day()).length,'Across demo schedule','▦')]:[stat('MEDICAL RECORDS',prs.length,'Organized in your health vault','▤'),stat('CURRENT MEDICATIONS',p.medications.filter(x=>!/^none/i.test(x)).length,'From profile records','✚'),stat('UPCOMING APPOINTMENTS',upcoming,'Scheduled visits','▦'),stat('ACTIVE SHARES',active,'Patient-approved access','⌁')].join('');
 const actions=`<button class="btn btn-primary" data-action="new-record">＋ Add record</button><button class="btn btn-soft" data-action="new-share">⌁ Share records</button>`;
