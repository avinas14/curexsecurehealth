${s.id}">Revoke access</button>`:''}<button class="btn btn-sm" data-action="share-details" data-id="${s.id}">Details</button></div></div></div>`).join('')||empty('⌁','No sharing requests','Create a request to demonstrate patient-controlled sharing.'))}`;
}
