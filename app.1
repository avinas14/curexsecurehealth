function render(){if(!db)db=loadDB();$('#crumb-current').textContent=titleFor(currentView);$('#app').classList.toggle('role-admin',currentRole==='admin');$$('.nav-item[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===currentView));$('#role-name').textContent=actorName();$('#role-label').textContent=currentRole==='patient'?'Patient account':currentRole==='doctor'?'Clinician account':'Administrator demo';$('#role-avatar').textContent=initials(actorName());$('#top-avatar').textContent=initials(actorName());$('#records-count').textContent=patientRecords().length;$('#requests-count').textContent=db.shares.filter(s=>s.status==='pending').length;
 const map={overview:renderOverview,records:renderRecords,medications:renderMedications,appointments:renderAppointments,sharing:renderSharing,emergency:renderEmergency,summaries:renderSummaries,audit:renderAudit,admin:renderAdmin,settings:renderSettings};(map[currentView]||renderOverview)();wireChartCleanup();}
function wireChartCleanup(){if(chart){chart.destroy();chart=null}}
function go(view){if(view==='admin'&&currentRole!=='admin'){toast('Switch to Administrator demo role to open this view.','error');return}currentView=view;searchTerm='';recordFilter='all';render();$('#sidebar').classList.remove('open');window.scrollTo({top:0,behavior:'smooth'})}
function openModal(html){$('#modal-content').innerHTML=html;$('#modal').showModal()}
function closeModal(){if($('#modal').open)$('#modal').close()}
function formButtons(label='Save'){return `<div class="modal-actions"><button class="btn" value="cancel">Cancel</button><button class="btn btn-primary" type="submit" id="modal-submit">${label}</button></div>`}
function showRecord(r){if(!r)return toast('Record not found.','error');addAudit('Record metadata viewed','approved',r.title,currentPatient,r.id);persist();openModal(`<h2 class="modal-title">${esc(r.title)}</h2><p class="modal-desc">${DEMO}</p><div class="info-row"><span>Category</span><b>${esc(r.category)}</b></div><div class="info-row"><span>Record date</span><b>${fmtDate(r.date)}</b></div><div class="info-row"><span>Patient</span><b>${esc(byPatient(r.patientId).name)}</b></div><div class="info-row"><span>Uploaded by</span><b>${esc(byDoctor(r.doctorId).name)}</b></div><div class="summary-block"><h4>Record notes</h4><p>${esc(r.notes)}</p></div><div class="alert info"><span>▤</span><div><strong>Document file</strong>This demo record contains metadata only; no original medical document is attached.</div></div><div class="modal-actions"><button class="btn" value="cancel">Close</button><button class="btn btn-primary" type="button" data-action="share-one" data-id="${r.id}">Share this record</button></div>`);render();}
function newRecord(){openModal(`<h2 class="modal-title">Add medical record</h2><p class="modal-desc">Add fictional record metadata. Real document storage is not configured in demo mode.</p><div class="form-grid"><div class="form-group full"><label class="field-label">Record title *</label><input class="field" name="title" required maxlength="120" placeholder="e.g. Blood test report"></div><div class="form-group"><label class="field-label">Category *</label><select class="field" name="category" required><option>Laboratory report</option><option>Prescription</option><option>Consultation note</option><option>Medical history</option><option>Treatment record</option><option>Diagnostic report</option></select></div><div class="form-group"><label class="field-label">Record date *</label><input class="field" name="date" type="date" value="${day()}" max="${day()}" required></div><div class="form-group full"><label class="field-label">Notes *</label><textarea class="field" name="notes" rows="3" maxlength="1000" required placeholder="Fictional summary; do not enter real health data"></textarea></div><div class="form-group full"><label class="field-label">Optional PDF/image attachment</label><input class="field" type="file" name="file" accept=".pdf,image/png,image/jpeg,image/webp"><div class="helper">In local demo, only filename metadata is retained. Supabase Storage upload requires live configuration.</div></div></div>${formButtons('Save record')}`);
 $('#modal-form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target),file=f.get('file');if(file&&file.size>8*1024*1024){toast('File exceeds the 8 MB demo limit.','error');return}const r={id:id(),title:String(f.get('title')).trim(),category:f.get('category'),patientId:currentPatient,doctorId:currentRole==='doctor'?doctor().id:'d1',date:f.get('date'),notes:String(f.get('notes')).trim()+(file&&file.size?` Attachment metadata: ${file.name} (${file.type||'unknown type'}).`:'')};if(!r.title||!r.notes)return toast('Complete all required fields.','error');db.records.unshift(r);addAudit('Record metadata created','approved',r.title,currentPatient,r.id);persist();closeModal();toast('Record metadata saved to this browser.');render();};}
function newShare(recordId=null){const p=currentPatient;const rs=patientRecords();if(!rs.length)return toast('Add a record before sharing.','error');openModal(`<h2 class="modal-title">Create a sharing request</h2><p class="modal-desc">Choose exactly which records to share. A patient must approve before access is granted.</p><div class="form-grid"><div class="form-group full"><label class="field-label">Requesting clinician *</label><select class="field" name="doctorId" required>${db.doctors.map(d=>`<option value="${d.id}">${esc(d.name)} · ${esc(d.specialty)} · ${esc(d.organization)}</option>`).join('')}</select></div><div class="form-group full"><label class="field-label">Purpose *</label><input class="field" name="purpose" required maxlength="160" placeholder="e.g. Cardiology follow-up"></div><div class="form-group"><label class="field-label">Access duration</label><select class="field" name="duration"><option value="1">1 hour</option><option value="4">4 hours</option><option value="24" selected>24 hours</option><option value="48">48 hours</option><option value="72">72 hours</option></select></div><div class="form-group"><label class="field-label">Token policy</label><select class="field" name="singleUse"><option value="true">Single use</option><option value="false">Reusable until expiry</option></select></div><div class="form-group full"><label class="field-label">Select records to share *</label><div style="max-height:190px;overflow:auto;border:1px solid var(--border);border-radius:10px;padding:0 12px">${rs.map(r=>`<label class="check-row"><input type="checkbox" name="records" value="${r.id}" ${recordId===r.id?'checked':''}><span><b>${esc(r.title)}</b><small>${esc(r.category)} · ${fmtDate(r.date)}</small></span></label>`).join('')}</div></div></div>${formButtons('Create request')}`);
 $('#modal-form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target),selected=f.getAll('records');if(!selected.length)return toast('Select at least one record.','error');const duration=Number(f.get('duration'));const s={id:id(),patientId:p,doctorId:f.get('doctorId'),records:selected,categories:[...new Set(selected.map(r=>rec(r)?.category).filter(Boolean))],purpose:String(f.get('purpose')).trim(),duration,status:'pending',created:now(),expires:new Date(Date.now()+duration*3600000).toISOString(),singleUse:f.get('singleUse')==='true',used:false};if(!s.purpose)return toast('Enter a sharing purpose.','error');db.shares.unshift(s);db.notifications.unshift({id:id(),title:'Sharing request created',body:`A request was created for ${byDoctor(s.doctorId).name}. Patient approval is required.`,type:'consent',date:now(),read:false,patientId:p});addAudit('Sharing request created','pending',s.purpose,p);persist();closeModal();toast('Request created. Approve it from the patient role to demonstrate consent.');go('sharing');};}
function detailsShare(s){if(!s)return;openModal(`<h2 class="modal-title">Sharing session details</h2><p class="modal-desc">Session ${esc(s.id.slice(0,8))} · ${DEMO}</p><div class="info-row"><span>Patient</span><b>${esc(byPatient(s.patientId).name)}</b></div><div class="info-row"><span>Clinician</span><b>${esc(byDoctor(s.doctorId).name)}</b></div><div class="info-row"><span>Organization</span><b>${esc(byDoctor(s.doctorId).organization)}</b></div><div class="info-row"><span>Purpose</span><b>${esc(s.purpose)}</b></div><div class="info-row"><span>Selected records</span><b>${s.records.length}</b></div><div class="info-row"><span>Expires</span><b>${fmtTime(s.expires)}</b></div><div class="info-row"><span>Single use</span><b>${s.singleUse?'Yes':'No'}</b></div><div class="info-row"><span>Token state</span>${status(s.status)}</div><div class="summary-block"><h4>Scope</h4><p>${s.records.map(r=>rec(r)?.title||r).map(esc).join(', ')}</p></div>${formButtons('Close')}`)}
function showQR(s){if(!s)return;if(s.status!=='approved'||new Date(s.expires)<new Date()||(s.singleUse&&s.used))return toast('This session is not currently usable.','error');const token=crypto.randomUUID?crypto.randomUUID():id()+id();s.demoToken=token;s.tokenCreated=now();persist();openModal(`<h2 class="modal-title">Secure sharing QR</h2><p class="modal-desc">Demo-only session link. QR contains a random temporary token, not medical data or a permanent credential.</p><div class="qr-wrap"><div id="qr-code"></div></div><div class="info-row"><span>Session</span><b>${esc(s.id.slice(0,8))}</b></div><div class="info-row"><span>Expires</span><b>${fmtTime(s.expires)}</b></div><div class="info-row"><span>Single-use</span><b>${s.singleUse?'Yes':'No'}</b></div><div class="alert"><span>⚠</span><div><strong>Demo limitation</strong>This locally generated QR is not backed by a verified server session. Do not use it for real patient information.</div></div><div class="modal-actions"><button class="btn" value="cancel">Close</button><button class="btn btn-primary" type="button" data-action="copy-share-link" data-id="${s.id}">Copy demo link</button></div>`);if(window.QRCode){new QRCode($('#qr-code'),{text:`${location.origin}${location.pathname}#share=${encodeURIComponent(s.id)}&token=${encodeURIComponent(token)}`,width:180,height:180,colorDark:'#174a35',colorLight:'#f5faf6',correctLevel:QRCode.CorrectLevel.M})}else $('#qr-code').textContent='QR library unavailable';}
function approveShare(s,approved){if(!s)return;s.status=approved?'approved':'rejected';s.updated=now();addAudit(approved?'Consent granted':'Consent rejected',s.status,`Sharing session ${s.id}`,s.patientId);db.notifications.unshift({id:id(),title:approved?'Sharing approved':'Sharing rejected',body:`Your sharing request for ${byDoctor(s.doctorId).name} was ${s.status}.`,type:'consent',date:now(),read:false,patientId:s.patientId});persist();toast(approved?'Consent approved.':'Request rejected.');render();}
function newAppointment(){openModal(`<h2 class="modal-title">Add appointment</h2><p class="modal-desc">Create a fictional appointment entry for the demo calendar.</p><div class="form-grid"><div class="form-group"><label class="field-label">Patient</label><select class="field" name="patientId">${db.patients.map(p=>`<option value="${p.id}" ${p.id===currentPatient?'selected':''}>${esc(p.name)}</option>`).join('')}</select></div><div class="form-group"><label class="field-label">Clinician</label><select class="field" name="doctorId">${db.doctors.map(d=>`<option value="${d.id}">${esc(d.name)}</option>`).join('')}</select></div><div class="form-group"><label class="field-label">Date</label><input class="field" name="date" type="date" min="${day()}" value="${day(1)}" required></div><div class="form-group"><label class="field-label">Time</label><input class="field" name="time" type="time" value="10:00" required></div><div class="form-group full"><label class="field-label">Appointment type</label><input class="field" name="type" maxlength="120" required placeholder="Follow-up consultation"></div></div>${formButtons('Save appointment')}`);$('#modal-form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);db.appointments.push({id:id(),patientId:f.get('patientId'),doctorId:f.get('doctorId'),date:f.get('date'),time:f.get('time'),type:String(f.get('type')).trim(),status:'scheduled'});addAudit('Appointment created','approved',String(f.get('type')),f.get('patientId'));persist();closeModal();toast('Appointment added to demo schedule.');render();};}
function emergencyRequest(){if(currentRole!=='doctor'&&currentRole!=='admin'){toast('Switch to Doctor demo role to request emergency access.','error');return}openModal(`<h2 class="modal-title">Emergency access request</h2><p class="modal-desc">Restricted break-glass simulation. A reason is mandatory and all requests are audited.</p><div class="form-group"><label class="field-label">Patient *</label><select class="field" name="patientId">${db.patients.map(p=>`<option value="${p.id}" ${p.id===currentPatient?'selected':''}>${esc(p.name)}</option>`).join('')}</select></div><div class="form-group"><label class="field-label">Reason for emergency access *</label><textarea class="field" name="reason" rows="3" maxlength="500" required placeholder="Document the urgent clinical reason"></textarea></div><div class="form-group"><label class="field-label">Minimum necessary information</label>${['Allergies','Conditions','Medications','Emergency contact'].map(x=>`<label class="check-row"><input type="checkbox" name="scope" value="${x}" ${x!=='Emergency contact'?'checked':''}><span>${x}</span></label>`).join('')}</div>${formButtons('Submit request')}`);$('#modal-form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target),scope=f.getAll('scope'),reason=String(f.get('reason')).trim();if(!reason||!scope.length)return toast('A reason and at least one scope item are required.','error');const patientId=f.get('patientId');db.emergency.unshift({id:id(),patientId,doctorId:doctor().id,reason,scope,status:'pending',created:now(),duration:1});addAudit('Emergency access requested','pending',reason,patientId);db.notifications.unshift({id:id(),title:'Emergency access request',body:`${actorName()} requested restricted emergency access.`,type:'emergency',date:now(),read:false,patientId});persist();closeModal();toast('Emergency request recorded; patient approval is pending.');render();};}
function addMedication(){openModal(`<h2 class="modal-title">Add medication or allergy</h2><p class="modal-desc">Adds demo profile information. Verify all clinical details with a healthcare professional.</p><div class="form-group"><label class="field-label">Entry type</label><select class="field" name="kind"><option value="medication">Current medication</option><option value="allergy">Recorded allergy</option></select></div><div class="form-group"><label class="field-label">Name *</label><input class="field" name="name" required maxlength="120"></div>${formButtons('Save entry')}`);$('#modal-form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target),name=String(f.get('name')).trim();if(!name)return toast('Enter a name.','error');if(f.get('kind')==='allergy')patient().allergies.push(name);else patient().medications.push(name);addAudit('Profile medical information updated','approved',`${f.get('kind')}: ${name}`,currentPatient);persist();closeModal();toast('Demo profile updated.');render();};}
function generateSummary(){const rs=patientRecords();if(!rs.length)return toast('No records available to summarize.','error');const selected=rs.slice(0,5);const text=`Demo summary created ${fmtDate(day())}: ${selected.length} source records are available, including ${[...new Set(selected.map(r=>r.category))].join(', ')}. Profile-reported allergies: ${patient().allergies.join(', ')}. Profile-listed medications: ${patient().medications.join(', ')}. This is a generated demo overview; verify every detail against original records. It is not a diagnosis.`;db.summaries.unshift({id:id(),patientId:currentPatient,title:'New source-linked demo summary',created:day(),sourceIds:selected.map(r=>r.id),text});addAudit('Demo summary created','approved',`${selected.length} source records`,currentPatient);persist();toast('Source-linked demo summary created.');render();}
function viewSummary(s){if(!s)return;openModal(`<h2 class="modal-title">${esc(s.title)}</h2><p class="modal-desc">DEMO SUMMARY · ${fmtDate(s.created)} · Not a diagnosis</p><div class="summary-block"><p>${esc(s.text)}</p></div><h3 style="font:700 12px Manrope">Source records</h3>${s.sourceIds.map(rid=>{const r=rec(rid);return r?`<div class="info-row"><span>${esc(r.title)}</span><button class="text-link" type="button" data-action="view-record" data-id="${r.id}">Open source</button></div>`:`<div class="info-row"><span>${esc(rid)}</span><span>Source unavailable</span></div>`}).join('')}${formButtons('Close')}`)}
function runSafetyCheck(){const p=patient(),all=p.allergies.filter(a=>!/^none/i.test(a));$('#safety-result').innerHTML=`<div class="alert ${all.length?'danger':'info'}"><span>${all.length?'⚠':'ⓘ'}</span><div><strong>${all.length?'Recorded allergy requires clinician review':'No recorded allergy in this demo profile'}</strong>${all.length?`Recorded: ${all.map(esc).join(', ')}. No live drug database was queried. Do not treat this as an interaction check.`:'Absence of a recorded allergy does not establish safety. This prototype did not query a drug interaction database.'}</div></div>`;addAudit('Demo allergy checklist run','reviewed','No external drug database queried',currentPatient);persist();}
function exportJSON(name,data){const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();URL.revokeObjectURL(url);toast('Export prepared.');}
function action(a,el){const rid=el.dataset.id;switch(a){
case'new-record':newRecord();break;case'view-record':closeModal();showRecord(rec(rid));break;case'share-one':closeModal();newShare(rid);break;case'new-share':newShare();break;
case'approve-share':approveShare(db.shares.find(s=>s.id===rid),true);break;case'reject-share':approveShare(db.shares.find(s=>s.id===rid),false);break;case'revoke-share':{const s=db.shares.find(s=>s.id===rid);if(s&&confirm('Revoke this sharing permission?')){s.status='revoked';s.revoked=now();addAudit('Sharing permission revoked','revoked',s.purpose,s.patientId);persist();toast('Sharing permission revoked in demo.');render();}}break;
case'show-qr':showQR(db.shares.find(s=>s.id===rid));break;case'share-details':detailsShare(db.shares.find(s=>s.id===rid));break;
case'copy-share-link':{const s=db.shares.find(s=>s.id===rid);const link=`${location.origin}${location.pathname}#share=${encodeURIComponent(s.id)}&token=${encodeURIComponent(s.demoToken||'not-generated')}`;navigator.clipboard?.writeText(link).then(()=>toast('Demo link copied.')).catch(()=>toast(link));break}
case'new-appointment':newAppointment();break;case'complete-appointment':{const x=db.appointments.find(x=>x.id===rid);if(x){x.status='completed';addAudit('Appointment marked complete','approved',x.type,x.patientId);persist();toast('Appointment updated.');render();}}break;
case'emergency-request':emergencyRequest();break;case'approve-emergency':{const e=db.emergency.find(e=>e.id===rid);if(e){e.status='approved';addAudit('Emergency access approved','approved',e.reason,e.patientId);persist();toast('Emergency access approved in demo.');render();}}break;case'reject-emergency':{const e=db.emergency.find(e=>e.id===rid);if(e){e.status='rejected';addAudit('Emergency access rejected','rejected',e.reason,e.patientId);persist();toast('Emergency request rejected.');render();}}break;
case'generate-summary':generateSummary();break;case'view-summary':viewSummary(db.summaries.find(s=>s.id===rid));break;case'add-medication':addMedication();break;case'safety-check':runSafetyCheck();break;
case'export-records':exportJSON('curex-demo-records.json',patientRecords());break;case'export-audit':exportJSON('curex-demo-audit.json',db.audit);break;case'export-demo':exportJSON('curex-demo-backup.json',db);break;
case'reset-demo':if(confirm('Reset all local demo data to the original fictional dataset? This affects this browser only.')){localStorage.removeItem('curex-demo-db-v1');db=clone(seed);persist();toast('Local demo data reset.');render();}break;
case'save-profile':{const v=$('#patient-switch')?.value;if(v){currentPatient=v;persist();toast('Demo profile selected.');render();}}break;
}}
document.addEventListener('click',e=>{const nav=e.target.closest('[data-view]');if(nav){e.preventDefault();go(nav.dataset.view);return}const a=e.target.closest('[data-action]');if(a){action(a.dataset.action,a);return}});
$('#role-switch').addEventListener('change',e=>{currentRole=e.target.value;document.body.dataset.role=currentRole;if(currentRole==='doctor')currentPatient='p1';if(currentRole==='admin')currentPatient='p1';render();toast(`Switched to ${currentRole} demo view. This is not authentication.`)});
$('#menu-btn').addEventListener('click',()=>$('#sidebar').classList.toggle('open'));
$('#logout-btn').addEventListener('click',()=>{if(confirm('Sign out and return to the Curex login page?')){sessionStorage.removeItem('curex-demo-session');$('#app').hidden=true;$('#auth-screen').hidden=false;$('#auth-password').value='';$('#auth-message').textContent='You have signed out.';window.scrollTo(0,0)}});
$('#settings-btn').addEventListener('click',()=>go('settings'));
$('#notifications-btn').addEventListener('click',()=>{const ns=db.notifications.filter(n=>currentRole==='admin'||n.patientId===currentPatient);openModal(`<h2 class="modal-title">Notifications</h2><p class="modal-desc">Security and sharing updates for this fictional profile.</p>${ns.map(n=>`<div class="consent-item"><span class="consent-symbol">${n.type==='security'?'⚑':n.type==='emergency'?'♡':'♧'}</span><div class="consent-info"><h3>${esc(n.title)} ${n.read?'':'<span class="tag">NEW</span>'}</h3><p>${esc(n.body)}</p><small class="muted">${fmtTime(n.date)}</small></div></div>`).join('')||empty('♧','No notifications','Nothing to show.')}${formButtons('Close')}`);db.notifications.filter(n=>n.patientId===currentPatient).forEach(n=>n.read=true);persist()});
$('#top-avatar').addEventListener('click',()=>go('settings'));
$('#modal').addEventListener('close',()=>{$('#modal-form').onsubmit=null});
document.addEventListener('input',e=>{if(e.target.id==='record-search'){searchTerm=e.target.value;const pos=e.target.selectionStart;renderRecords();const input=$('#record-search');input.focus();input.setSelectionRange(pos,pos)}if(e.target.id==='audit-search'){searchTerm=e.target.value;renderAudit();const input=$('#audit-search');input.focus();input.setSelectionRange(searchTerm.length,searchTerm.length)}});
document.addEventListener('change',e=>{if(e.target.id==='record-filter'){recordFilter=e.target.value;renderRecords()}if(e.target.id==='audit-outcome'){const outcome=e.target.value;const rows=db.audit.filter(a=>(currentRole==='admin'||currentRole==='doctor'||a.patientId===currentPatient)&&(outcome==='all'||a.outcome===outcome));const tb=$('#page-content tbody');if(tb)tb.innerHTML=rows.map(a=>`<tr><td>${fmtTime(a.date)}</td><td><b>${esc(a.actor)}</b><br><small class="muted">${esc(a.role)} · ${esc(a.org)}</small></td><td>${esc(a.action)}</td><td>${esc(byPatient(a.patientId).name)}</td><td>${status(a.outcome)}</td><td>${esc(a.detail)}</td></tr>`).join('')}});
window.addEventListener('hashchange',()=>{const m=location.hash.match(/share=([^&]+)/);if(m){const s=db.shares.find(s=>s.id===decodeURIComponent(m[1]));if(s){addAudit('QR session opened','pending','Demo QR link opened; server validation not performed',s.patientId);persist();openModal(`<h2 class="modal-title">Sharing session verification</h2><div class="alert"><span>⚠</span><div><strong>Demo verification only</strong>This link cannot grant real record access. A live application must validate token, expiry, single-use status, doctor identity, and patient consent server-side.</div></div><div class="info-row"><span>Session status</span>${status(s.status)}</div><div class="info-row"><span>Expiry</span><b>${fmtTime(s.expires)}</b></div>${formButtons('Close')}`)}}});
function setupCursor(){if(matchMedia('(hover:hover) and (pointer:fine)').matches&&!matchMedia('(prefers-reduced-motion: reduce)').matches){document.body.classList.add('cursor-active');const c=$('#custom-cursor');let x=0,y=0,tx=0,ty=0;window.addEventListener('mousemove',e=>{tx=e.clientX;ty=e.clientY});function tick(){x+=(tx-x)*.3;y+=(ty-y)*.3;c.style.left=x+'px';c.style.top=y+'px';requestAnimationFrame(tick)}tick();document.addEventListener('mousedown',()=>{c.classList.add('click');setTimeout(()=>c.classList.remove('click'),130)})}}
async function initSupabase(){try{const r=await fetch('./config.json',{cache:'no-store'});if(!r.ok)return;const cfg=await r.json();if(cfg.supabaseUrl&&cfg.supabaseAnonKey&&!cfg.supabaseUrl.includes('YOUR_')&&!cfg.supabaseAnonKey.includes('YOUR_')&&window.supabase){supa=window.supabase.createClient(cfg.supabaseUrl,cfg.supabaseAnonKey);console.info('Supabase client configured. Local demo data remains active until live data adapters are enabled.')}}catch(e){console.info('No optional Supabase config found; running local demo.')} }
async function syncToSupabase(){/* Safe default: no automatic patient-data sync. Live adapters require schema-specific, server-authorized operations. */}
db=loadDB();render();setupCursor();initSupabase();
function enterDemo(role='patient'){
 currentRole=role;document.body.dataset.role=currentRole;currentPatient='p1';
 const sw=$('#role-switch');if(sw)sw.value=role;
 $('#auth-screen').hidden=true;$('#app').hidden=false;sessionStorage.setItem('curex-demo-session','active');render();
 toast(`Opened ${role} demo view. This is not real authentication.`);
}
$('#login-form').addEventListener('submit',e=>{e.preventDefault();const email=$('#auth-email').value.trim();const password=$('#auth-password').value;if(!email||!password){$('#auth-message').textContent='Enter an email and password to continue.';return;}$('#auth-message').textContent='Demo sign-in only — no account was verified. Opening the selected demo role.';enterDemo($('#auth-role').value);});
$('#demo-login').addEventListener('click',()=>enterDemo($('#auth-role').value));
if(sessionStorage.getItem('curex-demo-session')==='active'){$('#auth-screen').hidden=true;$('#app').hidden=false;}else{$('#auth-screen').hidden=false;$('#app').hidden=true;}

if('serviceWorker' in navigator && location.protocol.startsWith('http'))navigator.serviceWorker.register('./sw.js').catch(()=>{});
})();