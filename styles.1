/* Login / demo entry screen */
[hidden]{display:none!important}.auth-screen{min-height:100vh;display:grid;grid-template-columns:minmax(320px,1fr) minmax(320px,.82fr);background:#f6f8f5;color:#183b2d;font-family:'DM Sans',sans-serif}.auth-card{width:min(100%,510px);margin:auto;padding:clamp(28px,6vw,72px)}.auth-brand{display:flex;align-items:center;gap:12px;margin-bottom:52px;color:#174a35}.auth-brand .brand-mark{width:46px;height:46px;display:grid;place-items:center;background:#174a35;color:white;border-radius:14px}.auth-brand svg{width:32px;height:32px}.auth-brand b{display:block;font:800 25px Manrope,sans-serif}.auth-brand small{display:block;font-size:10px;letter-spacing:2px;margin-top:2px}.auth-eyebrow{font-size:11px;font-weight:800;letter-spacing:2px;color:#438064}.auth-card h1{font:800 clamp(30px,4vw,42px) Manrope,sans-serif;margin:12px 0 8px}.auth-subtitle{color:#6b7d73;margin:0 0 28px}.auth-form{display:grid;gap:9px}.auth-form label{font-size:13px;font-weight:700;margin-top:8px}.auth-form input,.auth-form select{width:100%;box-sizing:border-box;border:1px solid #d9e2dc;border-radius:11px;padding:14px 13px;background:#fff;color:#183b2d;font:inherit;outline:none}.auth-form input:focus,.auth-form select:focus{border-color:#438064;box-shadow:0 0 0 3px #43806420}.auth-submit{margin-top:12px;border:0;border-radius:11px;padding:15px 18px;background:#174a35;color:#fff;font:700 15px Manrope,sans-serif;cursor:pointer;display:flex;justify-content:space-between}.auth-submit:hover{background:#226647}.auth-demo{width:100%;margin-top:12px;border:1px solid #cbd9d0;background:transparent;color:#174a35;border-radius:11px;padding:14px;font:700 14px Manrope,sans-serif;cursor:pointer}.auth-message{font-size:12px;color:#a04436;margin:0;min-height:16px}.auth-footnote{font-size:11px;line-height:1.6;color:#7c8981;margin-top:22px}.auth-side{background:linear-gradient(145deg,#174a35,#286b4a);color:white;padding:clamp(30px,6vw,76px);display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden}.auth-side:after{content:'';position:absolute;width:380px;height:380px;border:1px solid #ffffff22;border-radius:50%;right:-130px;top:-100px;box-shadow:0 0 0 45px #ffffff08,0 0 0 90px #ffffff06}.auth-side-icon{width:62px;height:62px;border-radius:20px;background:#ffffff1a;display:grid;place-items:center;font-size:34px}.auth-side h2{font:800 clamp(32px,4vw,48px) Manrope,sans-serif;line-height:1.14;margin:28px 0 14px}.auth-side p{color:#d5e6db;line-height:1.8;max-width:420px}.auth-feature{display:flex;align-items:center;gap:12px;margin-top:16px;font-size:14px}.auth-feature span{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:#ffffff20}@media(max-width:760px){.auth-screen{grid-template-columns:1fr}.auth-card{padding:28px 24px}.auth-brand{margin-bottom:35px}.auth-side{padding:32px 24px}.auth-side h2{font-size:32px}.auth-side p{margin-bottom:10px}}
